{{ define "main" }}
<div class="library-container">
    <h1 class="library-title">Document Library</h1>
    {{ range $i, $e := .Sections.ByTitle.Reverse }}
        {{ $year := (sub 2026 $i) }}
        <h2 class="archive-header">Archive {{ $year }}</h2>
        <table class="library-table">
            <thead>
                <tr>
                    <th>Monthly Newsletter</th>
                    <th>Interactive Star Map</th>
                    <th>Featured Constellation</th>
                </tr>
            </thead>
            <tbody>
                {{ range .Sections.ByTitle.Reverse }}
                <tr>
                    <td>
                        {{ range .Resources.Match "*newsletter*" }}
                        <a href="{{ .RelPermalink }}" target="_blank" class="lib-link">
                            <span>{{ .Name }}</span>
                        </a>
                        {{ end }}
                    </td>
                    <td>
                        {{ range .Resources.Match "*starmap*" }}
                        <a href="{{ .RelPermalink }}" target="_blank" class="lib-link">
                            <span>Map</span>
                        </a>
                        {{ end }}
                    </td>
                    <td>
                        {{ range .Resources.Match "*constellation*" }}
                        <a href="{{ .RelPermalink }}" target="_blank" class="lib-link">
                            <span>{{ .Name }}</span>
                        </a>
                        {{ end }}
                    </td>
                </tr>
                {{ end }}
            </tbody>
        </table>
    {{ end }}
</div>
{{ end }}
