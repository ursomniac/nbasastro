<!-- 1. CSS & HTML STRUCTURE (This prevents the code-plopping in your image) -->
<link rel="stylesheet" href="/css/astro-dashboard.css">

<div class="astro-controls">
    <h3>Active Observation Time: <span id="current-obs-time">Now</span></h3>
    <div style="margin-bottom: 15px;">
        <input type="datetime-local" id="astro-time-picker" class="astro-input">
        <button onclick="window.getAstroData()" class="btn-astro">Update Positions</button>
    </div>
</div>

<div class="astro-panel-container">
    <div class="astro-panel">
        <h4 class="panel-title">Planetary Positions</h4>
        <p class="panel-desc">Real-time coordinates and visibility for major bodies.</p>
        <div class="table-wrapper" id="planetary-dashboard-target"></div>
    </div>

    <div class="astro-panel">
        <h4 class="panel-title">Jupiter's Galilean Moons</h4>
        <p class="panel-desc">Relative positions in Jupiter Radii (Rj).</p>
        <div class="table-wrapper" id="jupiter-moons-target"></div>
    </div>
</div>

<!-- 2. LIBRARY LOAD (Added 'defer' to fix the 23s lag) -->
<script>
    window.exports = window.exports || {};
    window.Astronomy = window.exports;
</script>
<script src="/js/astronomy.min.js" defer></script>

<!-- 3. PROCESSING LOGIC -->
<script>
(function() {
    window.getAstroData = function() {
        const planetTarget = document.getElementById('planetary-dashboard-target');
        const moonTarget = document.getElementById('jupiter-moons-target');
        const timePicker = document.getElementById('astro-time-picker');
        const timeDisplay = document.getElementById('current-obs-time');
        const Astro = window.Astronomy;
        
        if (!planetTarget || !moonTarget || !Astro || !Astro.MakeTime) return;

        try {
            let date = new Date();
            if (timePicker && timePicker.value) {
                date = new Date(timePicker.value);
            }
            
            if (timeDisplay) {
                timeDisplay.innerText = date.toLocaleString();
            }

            const time = Astro.MakeTime(date);
            const obs = new Astro.Observer(42.7, -73.1, 0);

            const planets = [
                { name: 'Sun', id: Astro.Body.Sun }, { name: 'Moon', id: Astro.Body.Moon },
                { name: 'Mercury', id: Astro.Body.Mercury }, { name: 'Venus', id: Astro.Body.Venus },
                { name: 'Mars', id: Astro.Body.Mars }, { name: 'Jupiter', id: Astro.Body.Jupiter },
                { name: 'Saturn', id: Astro.Body.Saturn }, { name: 'Uranus', id: Astro.Body.Uranus },
                { name: 'Neptune', id: Astro.Body.Neptune }, { name: 'Pluto', id: Astro.Body.Pluto }
            ];

            // Planet Table
            let pHTML = `<table class="astro-table"><thead><tr>
                <th>Body</th><th>RA</th><th>DEC</th><th>AZ</th><th>ALT</th><th>MAG</th><th>PHASE</th><th>RISE/SET</th><th>TRANSIT</th>
            </tr></thead><tbody>`;

            for (const p of planets) {
                const equ = Astro.Equator(p.id, time, obs, true, true);
                const hor = Astro.Horizon(time, obs, equ.ra, equ.dec, "normal");
                const ill = Astro.Illumination(p.id, time);
                
                let eventStr = "-";
                try {
                    const nextRise = Astro.SearchRiseSet(p.id, obs, 1, time, 1);
                    const nextSet = Astro.SearchRiseSet(p.id, obs, -1, time, 1);
                    if (nextRise && nextSet) {
                        const isNextRise = nextRise.date < nextSet.date;
                        eventStr = (isNextRise ? "↑ " : "↓ ") + (isNextRise ? nextRise.date : nextSet.date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    }
                } catch(e) { eventStr = "-"; }

                let transitStr = "-";
                try {
                    const ra = equ.ra; 
                    const dayStart = new Date(date.getFullYear(), date.getMonth(), date.getDate());
                    const t0 = Astro.MakeTime(dayStart);
                    const lst0 = Astro.SiderealTime(t0) + (obs.longitude / 15.0);
                    let tH = (equ.ra - lst0);
                    while (tH < 0) tH += 24; while (tH >= 24) tH -= 24;
                    const tDate = new Date(dayStart.getTime() + (tH * 0.99726957 * 3600000));
                    transitStr = tDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                } catch(e) { transitStr = "-"; }

                pHTML += `<tr>
                    <td><strong>${p.name}</strong></td>
                    <td>${equ.ra.toFixed(2)}</td>
                    <td>${equ.dec.toFixed(2)}</td>
                    <td>${hor.azimuth.toFixed(1)}°</td>
                    <td>${hor.altitude.toFixed(1)}°</td>
                    <td>${(p.name==='Sun'?-26.7:ill.mag).toFixed(1)}</td>
                    <td>${(ill.phase_fraction * 100).toFixed(0)}%</td>
                    <td>${eventStr}</td>
                    <td>${transitStr}</td>
                </tr>`;
            }
            pHTML += `</tbody></table>`;
            planetTarget.innerHTML = pHTML;

            // Moon Table
            const jmFn = Astro.JupiterMoons || Astro.jupitermoons;
            if (jmFn) {
                let mHTML = `<table class="astro-table"><thead><tr>
                    <th>Moon</th><th>X (E/W)</th><th>Y (N/S)</th><th>Z (Depth)</th>
                </tr></thead><tbody>`;
                const jm = jmFn(time);
                const AU_TO_JUP = 149597870.7 / 71492.0; 
                const mList = [{l:'Io',k:'io'},{l:'Europa',k:'europa'},{l:'Ganymede',k:'ganymede'},{l:'Callisto',k:'callisto'}];
                
                mList.forEach(m => {
                    const moon = jm[m.k] || jm[m.l];
                    const pos = moon.rect || moon;
                    mHTML += `<tr>
                        <td>${m.l}</td>
                        <td>${(pos.x * AU_TO_JUP).toFixed(2)}</td>
                        <td>${(pos.y * AU_TO_JUP).toFixed(2)}</td>
                        <td>${(pos.z * AU_TO_JUP).toFixed(2)}</td>
                    </tr>`;
                });
                mHTML += `</tbody></table>`;
                moonTarget.innerHTML = mHTML;
            }
        } catch (e) { console.error("Astro Error:", e); }
    }

    const checker = setInterval(() => {
        if (window.Astronomy && window.Astronomy.Body) {
            clearInterval(checker);
            window.getAstroData();
        }
    }, 200);
})();
</script>

