{{- /* NBAS RSS feed template (all feed kinds).
     Based on Hugo's embedded rss.xml (v0.160.1). Changes:
     - Home feed: only sections listed in site.Params.rss_home_sections.
     - Members pages never appear in any feed.
     - Items sorted newest first by publish date (not by weight).
     - Channel title "Site Title" for home, "Page Title | Site Title" otherwise.
     - Item description uses front matter description, falling back to summary.
     Which page kinds get feeds is set by [outputs] / [[cascade]] in hugo.toml. */ -}}
{{- $pages := slice }}
{{- if .IsHome }}
  {{- $sections := site.Params.rss_home_sections | default (slice "articles") }}
  {{- $pages = where site.RegularPages "Section" "in" $sections }}
{{- else if .IsSection }}
  {{- $pages = .RegularPages }}
{{- else }}
  {{- $pages = .Pages }}
{{- end }}
{{- $pages = where $pages "Section" "ne" "members" }}
{{- $pages = $pages.ByPublishDate.Reverse }}
{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
  {{- $pages = $pages | first $limit }}
{{- end }}
{{- $title := site.Title }}
{{- if not .IsHome }}{{ $title = printf "%s | %s" .Title site.Title }}{{ end }}
{{- $desc := site.Params.tagline }}
{{- if not .IsHome }}{{ with .Description }}{{ $desc = . }}{{ end }}{{ end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $desc }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>{{ with site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ with $pages }}
    <lastBuildDate>{{ (index . 0).PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Description }}{{ . | transform.XMLEscape | safeHTML }}{{ else }}{{ .Summary | transform.XMLEscape | safeHTML }}{{ end }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
