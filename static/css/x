.discovery-pills {
    display: flex;
    gap: 12px;
}

.discovery-pill {
    background: #1a2a44;
    color: #c5a059; /* Logo Gold text */
    text-decoration: none;
    padding: 5px 15px;
    border-radius: 4px; /* Back to a 'button' feel instead of pill */
    font-size: 0.85rem;
    border: 1px solid #3a4a64;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 1px;
}

.discovery-pill:hover {
    border-color: #c5a059;
    background: #24344d;
}

.pill-count {
    color: #555;
    font-size: 0.75rem;
    margin-left: 8px;
}

.series-links {
    display: flex;
    gap: 20px;
}

.series-tag {
    color: #8e7037; /* Muted Bronze */
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: bold;
}

.series-tag:hover {
    color: #c5a059;
}




/* --- 99. Last content section--- */

/* --- RESPONSIVE LAYOUT (The "Sandwich" Fix) --- */
@media (max-width: 800px) {
    /* 1. Break the side-by-side flex and stack them */
    .nbas-container { 
        flex-direction: column; 
    }

    /* 2. Make Sidebar and Main take full width */
    .nbas-sidebar, .nbas-main {
        width: 100% !important;
        box-sizing: border-box;
    }

    /* 3. Handle the Sidebar contents for the Sandwich */
    .nbas-sidebar {
        display: contents; /* Allows children to move independently */
        border-right: none;
    }

    .sidebar-top { 
        order: 1; 
        padding: 20px; 
        border-bottom: 2px solid #3a4a64; 
    }

    .nbas-main { 
        order: 2; 
        padding: 20px; 
    }

    .sidebar-bottom { 
        order: 3; 
        padding: 20px; 
        border-top: 2px solid #3a4a64; 
    }

    /* 4. Header adjustments for mobile */
    .nbas-header {
        height: auto;
        flex-direction: column;
        text-align: center;
        padding: 20px;
    }

    .nbas-logo {
        margin-right: 0;
        margin-bottom: 15px;
        height: 100px;
    }

    .ratio-sky {
        padding-top: 38%; /* Mobile: Wider/shorter to fit the screen width */
    }
}


